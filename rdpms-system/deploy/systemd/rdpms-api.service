[Unit]
Description=RDPMS API (Hono + Prisma + PostgreSQL)
Documentation=file:///opt/rdpms/.deploy-meta
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300

[Service]
Type=simple
User=rdpms
Group=rdpms
WorkingDirectory=/opt/rdpms/current/rdpms-system/backend
Environment=NODE_ENV=production
Environment=HOME=/var/lib/rdpms
EnvironmentFile=/srv/rdpms/.env
# 注意：服务器上 Node 位于 /usr/local/bin/node（/usr/bin/node 不存在），写错将直接启动失败
#
# TypeScript 构建链（v2 ADR-02, 2026-09-15）：
#   入口改为构建产物 dist/index.js；`deploy.sh` 必须先执行 `npm run build`，
#   `[ -d dist ]` 断言失败即中止切流。
#   回退注意（release 级）：回退 = 把 /opt/rdpms/current 指回上一个**完整 release**，
#   并使用该 release 自带的启动配置。2026-09-15 之前（无 dist）的 release 必须把 ExecStart
#   改回 src/index.js；两侧不匹配时服务会启动失败并按 RestartSec 反复重启。
#   数据库向后兼容：mutation_receipts 为新增表，旧版本不会读写它，回退不需要回滚迁移。
ExecStart=/usr/local/bin/node dist/index.js

# 内存护栏（与同机 foodsentinel / foodsafety-outreach 惯例一致）
MemoryMax=1024M
Environment=NODE_OPTIONS=--max-old-space-size=768
Environment=TZ=Asia/Shanghai

Restart=always
RestartSec=5
StartLimitBurst=5
TimeoutStartSec=90
TimeoutStopSec=25
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
LimitNOFILE=65535

# 日志落数据盘（同机既定惯例：/mnt/datadisk0/<system>/logs/）
# 部署侧需预建该目录并 chown rdpms:rdpms
StandardOutput=append:/mnt/datadisk0/rdpms/logs/app.out.log
StandardError=append:/mnt/datadisk0/rdpms/logs/app.err.log
SyslogIdentifier=rdpms-api

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/srv/rdpms/uploads /mnt/datadisk0/rdpms/logs

[Install]
WantedBy=multi-user.target
