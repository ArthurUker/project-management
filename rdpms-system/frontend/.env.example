# ─────────────────────────────────────────────────────────────────────────────
# R&D PMS Frontend — 环境变量模板
#
# 使用方式：  cp .env.example .env
# 说明：      只有 VITE_ 前缀的变量才会暴露给前端；禁止在此放置任何密钥。
# ─────────────────────────────────────────────────────────────────────────────

# 后端 API 基地址。生产环境同域反代，保持 /api 即可，无需填写域名
VITE_API_BASE_URL=/api

VITE_APP_NAME=R&D PMS

# 上传大小上限（MB）。仅用于前端友好提示，真实限制由后端 MAX_UPLOAD_MB 与 Nginx client_max_body_size 决定
VITE_MAX_UPLOAD_MB=50
