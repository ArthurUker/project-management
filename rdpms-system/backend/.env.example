# ─────────────────────────────────────────────────────────────────────────────
# R&D PMS Backend — 环境变量模板（PostgreSQL-only）
#
# 使用方式：
#   cp .env.example .env
#   然后必须修改所有 <...> 占位符；缺项或仍为默认值时服务拒绝启动。
#
# 安全要求：
#   - .env 绝对不提交到 git（已在 .gitignore）
#   - 生产环境 .env 存放于 /srv/rdpms/.env，由 systemd EnvironmentFile 注入
# ─────────────────────────────────────────────────────────────────────────────

# ── 运行环境 ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── 数据库（PostgreSQL 唯一）──────────────────────────────────────────────────
# DATABASE_URL : 应用运行期使用（rdpms_app，仅 DML 权限）
# DIRECT_URL   : prisma migrate / seed 使用（rdpms_migrate，DDL 权限）
DATABASE_URL=postgresql://rdpms_app:<password>@127.0.0.1:5432/rdpms?schema=public&connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://rdpms_migrate:<password>@127.0.0.1:5432/rdpms?schema=public

# ── 鉴权 ──────────────────────────────────────────────────────────────────────
# JWT_SECRET 必须 >= 32 字符，严禁使用下列默认值（启动时会被拒绝）
JWT_SECRET=please-change-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS（production 下禁止 * 与 null）───────────────────────────────────────
# 多个来源用英文逗号分隔，必须带 scheme，不带尾斜杠
ALLOWED_ORIGINS=http://localhost:5173

# ── 文件上传 ──────────────────────────────────────────────────────────────────
# 必须是绝对路径，且不得位于应用代码目录内（启动时校验）
UPLOAD_DIR=/srv/rdpms/uploads
MAX_UPLOAD_MB=50
# local | s3 | cos —— 本轮仅实现 local
STORAGE_DRIVER=local

# ── 反向代理 ──────────────────────────────────────────────────────────────────
# 从 X-Forwarded-For 末尾往前数第 N 个 IP 视为真实客户端 IP
# Nginx 直连后端 = 1；多层代理按实际层数调整
TRUST_PROXY_HOPS=1

# ── 备份导出（仅 admin，默认关闭）────────────────────────────────────────────
# 应用层不提供 restore；真正的备份走 pg_dump + WAL，由运维负责
ENABLE_BACKUP_EXPORT=false

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=please-change
# 设为 1 时额外写入演示业务数据（生产禁止）
SEED_DEMO=0
