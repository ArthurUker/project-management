// =============================================================================
// RDPMS / IVD 注册研发项目管理系统 —— PostgreSQL-only baseline schema
//
// 唯一真值：本文件。任何 DDL 变更必须先改本文件 → 生成迁移 → migrate deploy。
// 旧 SQLite 迁移与 dev.db 已于本次重构删除，不做任何兼容。
//
// 约定（违反即为缺陷）：
//   1. 所有时间戳用 @db.Timestamptz(3)（Prisma 默认 timestamp 不带时区，必须显式覆盖）
//   2. 所有 JSON 用 Json @db.JsonB
//   3. 所有业务日期（无时刻语义）用 @db.Date
//   4. 所有金额/浓度/分子量用 Decimal 并显式精度
//   5. 表与列统一 snake_case（@@map / @map）
//   6. 状态/类型一律 Prisma enum（英文值），中文展示由 enum_meta 提供
//   7. 业务编号一经生成永不复用；删除后只能 restore，不能重建同编号
//   8. 文件只存元数据，二进制绝不入库
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

