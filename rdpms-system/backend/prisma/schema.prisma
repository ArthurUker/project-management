}

model ReportVersion {
  id          String   @id @default(uuid()) @map("id")
  reportId    String   @map("report_id")
  version     Int      @map("version")
  content     Json     @map("content") @db.JsonB
  changelog   String?  @map("changelog")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id")

  report  Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creator User?  @relation("ReportVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([reportId, version])
  @@map("report_versions")
}

model MonthlyProgress {
  id                String         @id @default(uuid()) @map("id")
  projectId         String         @map("project_id")
  periodKey         String         @map("period_key") @db.VarChar(7) // 2026-03
  actualWork        String?        @map("actual_work")
  completionPercent Int            @default(0) @map("completion_percent") // CHECK 0-100
  nextPlan          String?        @map("next_plan")
  risks             String?        @map("risks")
  projectStatus     ProjectStatus? @map("project_status")
  submittedById     String         @map("submitted_by_id")
  submittedAt       DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
