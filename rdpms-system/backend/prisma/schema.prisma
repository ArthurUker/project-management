// ======================= 身份、角色、权限、会话 ==============================

model User {
  id                 String     @id @default(uuid()) @map("id")
  // 规范化小写存储（DB 层 CHECK(username = lower(username)) 兜底），避免大小写产生第二个身份
  username           String     @unique @map("username") @db.VarChar(64)
  email              String?    @unique @map("email") @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  displayName        String     @map("display_name") @db.VarChar(128)
  position           String?    @map("position") @db.VarChar(128)
  department         String?    @map("department") @db.VarChar(128)
  phone              String?    @map("phone") @db.VarChar(32)
  systemRole         SystemRole @default(MEMBER) @map("system_role")
  status             UserStatus @default(ACTIVE) @map("status")
  avatarFileId       String?    @unique @map("avatar_file_id")

  // 登录安全
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  avatarFile   FileObject? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  createdBy    User?       @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?       @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdUsers User[]      @relation("UserCreatedBy")
  updatedUsers User[]      @relation("UserUpdatedBy")

  roles                UserRole[]
  refreshTokens        RefreshToken[]
  managedProjects      Project[]             @relation("ProjectManager")
  memberships          ProjectMember[]
  assignedTasks        Task[]                @relation("TaskAssignee")
  authoredReports      Report[]              @relation("ReportAuthor")
  reviewedReports      Report[]              @relation("ReportReviewer")
  monthlyProgress      MonthlyProgress[]
  ownedDocs            DocDocument[]         @relation("DocOwner")
  reviewedDocs         DocDocument[]         @relation("DocReviewer")
  docVersions          DocVersion[]
  reportVersions       ReportVersion[]       @relation("ReportVersionCreator")
  createdTemplates     ProjectTemplate[]     @relation("TemplateCreator")
  createdTaskTemplates TaskTemplate[]        @relation("TaskTemplateCreator")
  formulas             ReagentFormula[]      @relation("FormulaCreator")
  prepRecords          PrepRecord[]
  primers              Primer[]
  samples              SampleMaterial[]
  uploadedFiles        FileObject[]
  attachments          Attachment[]
  registrationProfiles RegistrationProfile[] @relation("RegistrationComplianceOwner")
  auditLogs            AuditLog[]
  systemLogs           SystemLog[]
  syncDevices          SyncDevice[]

  @@index([systemRole, status])
  @@index([department])
  @@index([deletedAt])
  @@map("users")
}

// ========================== 离线同步 v2（批次四）============================
// 设计：服务端不存业务影子表 —— 增量由业务表 updatedAt/deletedAt 派生；
//       本组两张表只负责「设备登记」与「上行幂等键（clientMutationId）」。

model SyncDevice {
  id         String    @id @map("id") @db.VarChar(64) // 客户端生成的设备标识（uuid）
  userId     String    @map("user_id")
  label      String?   @map("label") @db.VarChar(128)
  platform   String?   @map("platform") @db.VarChar(64)
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastPushAt DateTime? @map("last_push_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutations SyncMutation[]

  @@index([userId, lastSyncAt])
  @@map("sync_devices")
}

model SyncMutation {
  id               String   @id @default(uuid()) @map("id")
  clientMutationId String   @unique @map("client_mutation_id") @db.VarChar(64)
  deviceId         String   @map("device_id")
  userId           String   @map("user_id")
  entity           String   @map("entity") @db.VarChar(64)
  entityId         String   @map("entity_id")
  op               String   @map("op") @db.VarChar(16)
  status           String   @map("status") @db.VarChar(24) // applied / conflict / rejected
  result           Json?    @map("result") @db.JsonB       // 回放用：原样返回首次处理结果
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device SyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
  @@map("sync_mutations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") // 刷新令牌轮换与重放检测
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @map("ip") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid()) @map("id")
  code        String  @unique @map("code") @db.VarChar(64)
  name        String  @map("name") @db.VarChar(128)
  description String? @map("description")
  isSystem    Boolean @default(false) @map("is_system") // 系统内置角色不可删除
  sortOrder   Int     @default(0) @map("sort_order")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

// M-1 v1.0：权限真源。code 命名空间 = resource.action（小写下划线）。
// 首版只播种 P0 90 条；P1 30 条不入库。
// isHighRisk 标注 8 项高危（见 M-1 §5），仅作展示/审计提示，不参与鉴权判定。
model Permission {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique @map("code") @db.VarChar(64)
  name        String   @map("name") @db.VarChar(128)
  description String?  @map("description")
  module      String?  @map("module") @db.VarChar(64) // users / projects / reagents ...
  isHighRisk  Boolean  @default(false) @map("is_high_risk")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String?  @map("assigned_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================ 项目与模板 ====================================

model Project {
  id            String        @id @default(uuid()) @map("id")
  code          String        @unique @map("code") @db.VarChar(64) // PRJ-2026-001，编号永不复用
  name          String        @map("name") @db.VarChar(255)
  type          ProjectType   @map("type")
  subtype       String?       @map("subtype") @db.VarChar(128)
  status        ProjectStatus @default(PLANNING) @map("status")
  isDraft       Boolean       @default(false) @map("is_draft")
  positioning   String?       @map("positioning") // 项目定位/描述（旧字段名 position 与"职位"歧义）
  managerId     String        @map("manager_id")
  templateId    String?       @map("template_id")
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  actualEndDate DateTime?     @map("actual_end_date") @db.Date
  metadata      Json?         @map("metadata") @db.JsonB // 仅扩展属性，禁止堆放业务字段

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  manager             User                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  template            ProjectTemplate?     @relation("ProjectTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  members             ProjectMember[]
  phases              ProjectPhase[]
  tasks               Task[]
  milestones          Milestone[]
  reports             Report[]
  monthlyProgress     MonthlyProgress[]
  formulas            ReagentFormula[]
  primers             Primer[]
  samples             SampleMaterial[]
  registrationProfile RegistrationProfile?

  @@index([status, deletedAt])
  @@index([managerId])
  @@index([type])
  @@index([templateId])
  @@index([startDate])
  @@map("projects")
}

model ProjectMember {
  id          String            @id @default(uuid()) @map("id")
  projectId   String            @map("project_id")
  userId      String            @map("user_id")
  role        ProjectMemberRole @default(MEMBER) @map("role")
  joinedAt    DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt      DateTime?         @map("left_at") @db.Timestamptz(3) // 退出不删行，保证成员全量唯一
  createdById String?           @map("created_by_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, leftAt])
  @@map("project_members")
}

model ProjectTemplate {
  id          String         @id @default(uuid()) @map("id")
  code        String         @unique @map("code") @db.VarChar(64)
  name        String         @map("name") @db.VarChar(255)
  description String?        @map("description")
  category    String?        @map("category") @db.VarChar(64) // reagent_chip | device
  typeLabel   String?        @map("type_label") @db.VarChar(128)
  status      TemplateStatus @default(ACTIVE) @map("status")
  isMaster    Boolean        @default(false) @map("is_master")
  parentId    String?        @map("parent_id")
  config      Json?          @map("config") @db.JsonB // 仅保留真正无固定结构的配置

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  parent   ProjectTemplate?  @relation("TemplateTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProjectTemplate[] @relation("TemplateTree")
  creator  User              @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  projects Project[]         @relation("ProjectTemplate")
  phases   TemplatePhase[]
  roles    TemplateRole[]

  @@index([parentId])
  @@index([category, status])
  @@map("project_templates")
}

model TemplateRole {
  id          String   @id @default(uuid()) @map("id")
  templateId  String   @map("template_id")
  code        String   @map("code") @db.VarChar(64) // owner / tech_lead / member
  name        String   @map("name") @db.VarChar(128)
  description String?  @map("description")
  permissions String[] @map("permissions") // PG 原生 text[]，替代逗号分隔字符串
  sortOrder   Int      @default(0) @map("sort_order")

  template ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId])
  @@map("template_roles")
}

model TemplatePhase {
  id                     String  @id @default(uuid()) @map("id")
  templateId             String  @map("template_id")
  code                   String  @map("code") @db.VarChar(64)
  name                   String  @map("name") @db.VarChar(255)
  description            String? @map("description")
  sortOrder              Int     @map("sort_order")
  plannedStartOffsetDays Int?    @map("planned_start_offset_days") // 相对项目开始日的偏移
  plannedDurationDays    Int?    @map("planned_duration_days")
  isMilestone            Boolean @default(false) @map("is_milestone")

  template  ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks     TemplateTask[]
  instances ProjectPhase[]

  @@unique([templateId, code])
  @@index([templateId, sortOrder])
  @@map("template_phases")
}

model TemplateTask {
  id                  String            @id @default(uuid()) @map("id")
  templatePhaseId     String            @map("template_phase_id")
  code                String?           @map("code") @db.VarChar(64)
  title               String            @map("title") @db.VarChar(500)
  description         String?           @map("description")
  taskType            TaskType          @default(OTHER) @map("task_type")
  applicability       TaskApplicability @default(REQUIRED) @map("applicability")
  regulatoryPriority  PriorityLevel     @default(P2) @map("regulatory_priority")
  expectedDeliverable String?           @map("expected_deliverable")
  regulatoryNotes     String?           @map("regulatory_notes")
  estimatedHours      Decimal?          @map("estimated_hours") @db.Decimal(10, 2)
  assigneeRoleCode    String?           @map("assignee_role_code") @db.VarChar(64) // 指向 TemplateRole.code
  sortOrder           Int               @default(0) @map("sort_order")

  templatePhase TemplatePhase @relation(fields: [templatePhaseId], references: [id], onDelete: Cascade)

  @@unique([templatePhaseId, sortOrder, title])
  @@index([templatePhaseId])
  @@index([taskType])
  @@map("template_tasks")
}

// 项目实例化后的阶段（旧系统只有字符串 phaseId，此处为结构性修复）
model ProjectPhase {
  id              String      @id @default(uuid()) @map("id")
  projectId       String      @map("project_id")
  templatePhaseId String?     @map("template_phase_id")
  code            String      @map("code") @db.VarChar(64)
  name            String      @map("name") @db.VarChar(255)
  sortOrder       Int         @map("sort_order")
  status          PhaseStatus @default(NOT_STARTED) @map("status")
  plannedStart    DateTime?   @map("planned_start") @db.Date
  plannedEnd      DateTime?   @map("planned_end") @db.Date
  actualStart     DateTime?   @map("actual_start") @db.Date
  actualEnd       DateTime?   @map("actual_end") @db.Date
  progressPercent Int         @default(0) @map("progress_percent") // 0-100，CHECK 约束
  isMilestone     Boolean     @default(false) @map("is_milestone")
  notes           String?     @map("notes")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templatePhase TemplatePhase?    @relation(fields: [templatePhaseId], references: [id], onDelete: SetNull)
  tasks         Task[]
  milestones    Milestone[]
  outgoing      PhaseTransition[] @relation("TransitionFrom")
  incoming      PhaseTransition[] @relation("TransitionTo")

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
  @@index([status, deletedAt])
  @@map("project_phases")
}

model PhaseTransition {
  id          String   @id @default(uuid()) @map("id")
  fromPhaseId String   @map("from_phase_id")
  toPhaseId   String   @map("to_phase_id")
  condition   String?  @map("condition")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  fromPhase ProjectPhase @relation("TransitionFrom", fields: [fromPhaseId], references: [id], onDelete: Cascade)
  toPhase   ProjectPhase @relation("TransitionTo", fields: [toPhaseId], references: [id], onDelete: Cascade)

  @@unique([fromPhaseId, toPhaseId])
  @@index([toPhaseId])
  @@map("phase_transitions")
}

model Milestone {
  id          String     @id @default(uuid()) @map("id")
  projectId   String     @map("project_id")
  phaseId     String?    @map("phase_id")
  name        String     @map("name") @db.VarChar(255)
  description String?    @map("description")
  dueDate     DateTime   @map("due_date") @db.Date
  status      TaskStatus @default(NOT_STARTED) @map("status")
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, dueDate])
  @@index([status, dueDate])
  @@index([phaseId])
  @@map("milestones")
}

// ================================ 任务 ======================================

model Task {
  id                  String            @id @default(uuid()) @map("id")
  projectId           String            @map("project_id")
  phaseId             String?           @map("phase_id")
  parentId            String?           @map("parent_id")
  templateTaskId      String?           @map("template_task_id")
  code                String?           @map("code") @db.VarChar(64)
  title               String            @map("title") @db.VarChar(500)
  description         String?           @map("description")
  assigneeId          String?           @map("assignee_id")
  status              TaskStatus        @default(NOT_STARTED) @map("status")
  priority            TaskPriority      @default(MEDIUM) @map("priority")
  taskType            TaskType?         @map("task_type")
  applicability       TaskApplicability @default(REQUIRED) @map("applicability")
  regulatoryPriority  PriorityLevel?    @map("regulatory_priority")
  expectedDeliverable String?           @map("expected_deliverable")
  regulatoryNotes     String?           @map("regulatory_notes")
  sortOrder           Int               @default(0) @map("sort_order")
  estimatedHours      Decimal?          @map("estimated_hours") @db.Decimal(10, 2)
  actualHours         Decimal?          @map("actual_hours") @db.Decimal(10, 2)
  progressPercent     Int               @default(0) @map("progress_percent")
  startDate           DateTime?         @map("start_date") @db.Date
  dueDate             DateTime?         @map("due_date") @db.Date
  startedAt           DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parent   Task?         @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]        @relation("TaskHierarchy")
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  prerequisites       TaskDependency[]         @relation("TaskDependencies")
  dependents          TaskDependency[]         @relation("DependentTasks")
  regulatoryDocuments TaskRegulatoryDocument[]
  docRefs             TaskDocRef[]

  @@unique([projectId, code])
  @@index([projectId, status, deletedAt])
  @@index([projectId, phaseId])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([parentId])
  @@map("tasks")
}

// Q-a（W10 / Contract Review v2）：任务依赖类型四值枚举
enum DependencyType {
  FS
  SS
  FF
  SF
}

model TaskDependency {
  id             String         @id @default(uuid()) @map("id")
  taskId         String         @map("task_id")
  prerequisiteId String         @map("prerequisite_id")
  dependencyType DependencyType @default(FS) @map("dependency_type")
  lagDays        Int            @default(0) @map("lag_days")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  task         Task @relation("DependentTasks", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("TaskDependencies", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("task_dependencies")
}

// Tencent Task.docRefs（任务关联知识库文档 {id,code,title,docType,version}）的结构化承接
model TaskDocRef {
  taskId        String   @map("task_id")
  docDocumentId String   @map("doc_document_id")
  note          String?  @map("note")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?  @map("created_by_id")

  task Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doc  DocDocument @relation(fields: [docDocumentId], references: [id], onDelete: Cascade)

  @@id([taskId, docDocumentId])
  @@index([docDocumentId])
  @@map("task_doc_refs")
}

model TaskTemplate {
  id            String       @id @default(uuid()) @map("id")
  code          String       @unique @map("code") @db.VarChar(64)
  name          String       @map("name") @db.VarChar(255)
  category      String?      @map("category") @db.VarChar(64)
