model Report {
  id             String       @id @default(uuid()) @map("id")
  projectId      String       @map("project_id")
  authorId       String       @map("author_id")
  reviewerId     String?      @map("reviewer_id")
  reportType     ReportType   @default(MONTHLY) @map("report_type")
  periodKey      String       @map("period_key") @db.VarChar(16) // 2026-03 / 2026-W12 / 2026-03-05
  periodStart    DateTime?    @map("period_start") @db.Date
  periodEnd      DateTime?    @map("period_end") @db.Date
  content        Json         @map("content") @db.JsonB
  status         ReportStatus @default(DRAFT) @map("status")
  currentVersion Int          @default(1) @map("current_version")
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?      @map("review_note")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User            @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User?           @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  versions ReportVersion[]

  @@unique([projectId, authorId, reportType, periodKey])
  @@index([projectId, status, deletedAt])
  @@index([authorId, periodKey])
