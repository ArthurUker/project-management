model DocDocument {
  id             String         @id @default(uuid()) @map("id")
  categoryId     String         @map("category_id")
  code           String         @unique @map("code") @db.VarChar(64) // SOP-RG-LAMP-001
  title          String         @map("title") @db.VarChar(500)
  description    String?        @map("description")
  docType        DocType        @default(SOP) @map("doc_type")
  content        String?        @map("content") // 富文本/Markdown 正文
  currentVersion String         @default("V1.0") @map("current_version") @db.VarChar(16)
  status         DocumentStatus @default(DRAFT) @map("status")
  tags           String[]       @map("tags") // text[]，GIN 索引见 baseline 迁移
  ownerId        String         @map("owner_id")
  reviewerId     String?        @map("reviewer_id")
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  effectiveDate  DateTime?      @map("effective_date") @db.Date
  reviewDueDate  DateTime?      @map("review_due_date") @db.Date

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  category   DocCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
