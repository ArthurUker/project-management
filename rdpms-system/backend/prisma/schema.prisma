  reviewer   User?        @relation("DocReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  versions   DocVersion[]
  taskDocRef TaskDocRef[]

  @@index([categoryId, status, deletedAt])
  @@index([docType])
  @@map("doc_documents")
}

model DocVersion {
  id          String   @id @default(uuid()) @map("id")
  documentId  String   @map("document_id")
  version     String   @map("version") @db.VarChar(16)
  content     String   @map("content")
  changelog   String?  @map("changelog")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String   @map("created_by_id")

  document DocDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@map("doc_versions")
}

// ========================= 试剂物料、配方、配制 =============================

// 合并旧 Reagent 与 ReagentMaterial：单一物料主数据，消除双写漂移
model ReagentMaterial {
  id               String            @id @default(uuid()) @map("id")
  code             String            @unique @map("code") @db.VarChar(64)
  commonName       String            @map("common_name") @db.VarChar(255)
  chineseName      String?           @map("chinese_name") @db.VarChar(255)
  englishName      String?           @map("english_name") @db.VarChar(255)
  category         MaterialCategory  @default(OTHER) @map("category")
  casNumber        String?           @map("cas_number") @db.VarChar(32)
  molecularFormula String?           @map("molecular_formula") @db.VarChar(128)
  molecularWeight  Decimal?          @map("molecular_weight") @db.Decimal(12, 4)
  purity           Decimal?          @map("purity") @db.Decimal(8, 4) // 百分数，CHECK 0-100
  density          Decimal?          @map("density") @db.Decimal(12, 6)
  state            MaterialState     @default(LIQUID) @map("state")
  defaultStockConc Decimal?          @map("default_stock_conc") @db.Decimal(18, 8)
  defaultStockUnit ConcentrationUnit @default(M) @map("default_stock_unit")
  hazardLevel      String?           @map("hazard_level") @db.VarChar(32)
  supplier         String?           @map("supplier") @db.VarChar(255)
  storageCondition String?           @map("storage_condition") @db.VarChar(128)
  notes            String?           @map("notes")
  status           DocumentStatus    @default(ACTIVE) @map("status")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  components FormulaComponent[]
  lots       ReagentLot[]

  @@index([commonName])
  @@index([category, status])
  @@index([casNumber])
  @@map("reagent_materials")
}

model ReagentLot {
  id             String    @id @default(uuid()) @map("id")
  materialId     String    @map("material_id")
  lotNo          String    @map("lot_no") @db.VarChar(64)
  quantity       Decimal   @map("quantity") @db.Decimal(14, 4)
  unit           String    @default("g") @map("unit") @db.VarChar(16)
  receivedAt     DateTime? @map("received_at") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  location       String?   @map("location") @db.VarChar(128)
  supplier       String?   @map("supplier") @db.VarChar(255)
  certificateUrl String?   @map("certificate_url") @db.VarChar(1024)
  status         LotStatus @default(AVAILABLE) @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  material ReagentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, lotNo])
  @@index([expiryDate])
  @@map("reagent_lots")
}

model ReagentFormula {
  id        String        @id @default(uuid()) @map("id")
  code      String        @unique @map("code") @db.VarChar(64)
  name      String?       @map("name") @db.VarChar(255)
  type      FormulaType   @default(OTHER) @map("type")
  pH        Decimal?      @map("ph") @db.Decimal(6, 2)
  status    FormulaStatus @default(DRAFT) @map("status")
  projectId String?       @map("project_id")
  procedure String?       @map("procedure")
  notes     String?       @map("notes")
  version   Int           @default(1) @map("version")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  creator     User               @relation("FormulaCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  components  FormulaComponent[]
  prepRecords PrepRecord[]

  @@index([type, status, deletedAt])
  @@index([projectId])
  @@map("reagent_formulas")
}

model FormulaComponent {
  id                String            @id @default(uuid()) @map("id")
  formulaId         String            @map("formula_id")
  materialId        String?           @map("material_id")
  customName        String?           @map("custom_name") @db.VarChar(255) // 非标准组分（如引物）
  concentration     Decimal?          @map("concentration") @db.Decimal(18, 8)
  unit              ConcentrationUnit @default(M) @map("unit")
  concentrationText String?           @map("concentration_text") @db.VarChar(64) // 终浓度描述："1×"、"0.2μM"
  notes             String?           @map("notes")
  sortOrder         Int               @default(0) @map("sort_order")

  formula  ReagentFormula   @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  material ReagentMaterial? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([formulaId, sortOrder])
  @@index([materialId])
  @@map("formula_components")
}

model PrepRecord {
  id           String   @id @default(uuid()) @map("id")
  formulaId    String   @map("formula_id")
  targetVolume Decimal  @map("target_volume") @db.Decimal(14, 4)
  volumeUnit   String   @default("mL") @map("volume_unit") @db.VarChar(16)
  calcResult   Json     @map("calc_result") @db.JsonB // 计算明细（旧版为 String）
  prepDate     DateTime @map("prep_date") @db.Timestamptz(3) // 旧版为 String
  operator     String?  @map("operator") @db.VarChar(128)
  batchNo      String?  @map("batch_no") @db.VarChar(64)
  notes        String?  @map("notes")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String   @map("created_by_id")

  formula ReagentFormula @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  creator User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([formulaId, prepDate])
  @@index([batchNo])
  @@map("prep_records")
}

// ========================== 检测靶标与引物 ==================================

model DetectionTarget {
  id              String         @id @default(uuid()) @map("id")
  code            String         @unique @map("code") @db.VarChar(64)
  name            String         @map("name") @db.VarChar(255)
  geneSymbol      String?        @map("gene_symbol") @db.VarChar(64)
  organismLatin   String?        @map("organism_latin") @db.VarChar(255)
  organismChinese String?        @map("organism_chinese") @db.VarChar(255)
  taxid           String?        @map("taxid") @db.VarChar(32)
  atccStrain      String?        @map("atcc_strain") @db.VarChar(128)
  notes           String?        @map("notes")
  status          DocumentStatus @default(ACTIVE) @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  primers Primer[]

  @@index([organismLatin])
  @@index([geneSymbol])
  @@map("detection_targets")
}

model Primer {
  id               String         @id @default(uuid()) @map("id")
  code             String         @unique @map("code") @db.VarChar(64) // PRM-2026-001
  name             String         @map("name") @db.VarChar(255)
  type             PrimerType     @default(PRIMER) @map("type")
  sequence         String         @map("sequence") @db.VarChar(512) // 5'-3'
  projectId        String?        @map("project_id") // 旧版为文本 projectName
  targetId         String?        @map("target_id") // 旧版为文本 detectionTarget
  targetGene       String?        @map("target_gene") @db.VarChar(128)
  validatedStrain  String?        @map("validated_strain") @db.VarChar(128) // Tencent 承接：验证菌株（引物级）
  modification5    String?        @map("modification5") @db.VarChar(128)
  modification3    String?        @map("modification3") @db.VarChar(128)
  ampliconLength   Int?           @map("amplicon_length")
  synthesisAmount  String?        @map("synthesis_amount") @db.VarChar(64)
  synthesisCompany String?        @map("synthesis_company") @db.VarChar(255)
  tubeCount        Int?           @map("tube_count")
  notes            String?        @map("notes")
  status           DocumentStatus @default(ACTIVE) @map("status")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  target  DetectionTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  creator User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, status, deletedAt])
  @@index([targetId])
  @@index([name])
  @@map("primers")
}

// ================================ 样本 ======================================

model SampleMaterial {
  id               String       @id @default(uuid()) @map("id")
  sampleCode       String       @unique @map("sample_code") @db.VarChar(64) // SMP-2026-001
  sampleName       String       @map("sample_name") @db.VarChar(255)
  sampleType       SampleType   @default(CLINICAL_SAMPLE) @map("sample_type")
  projectId        String?      @map("project_id")
  species          String?      @map("species") @db.VarChar(255)
  tissue           String?      @map("tissue") @db.VarChar(255)
  concentration    String?      @map("concentration") @db.VarChar(128) // 自由文本，如 1×10^6 copies/mL
  volume           String?      @map("volume") @db.VarChar(128)
  storageCondition String       @default("-80°C") @map("storage_condition") @db.VarChar(128)
  receivedAt       DateTime?    @map("received_at") @db.Date
  expiryDate       DateTime?    @map("expiry_date") @db.Date
  supplier         String?      @map("supplier") @db.VarChar(255)
  status           SampleStatus @default(AVAILABLE) @map("status")
  notes            String?      @map("notes")

  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, status, deletedAt])
  @@index([sampleType])
  @@index([expiryDate])
  @@map("sample_materials")
}

// ========================= 文件元数据与附件 =================================

// 只存元数据，二进制永远不在数据库
model FileObject {
  id           String              @id @default(uuid()) @map("id")
  storageKey   String              @unique @map("storage_key") @db.VarChar(1024) // 存储对象键，全局唯一
  provider     FileStorageProvider @default(LOCAL) @map("provider")
  bucket       String?             @map("bucket") @db.VarChar(255)
  originalName String              @map("original_name") @db.VarChar(512)
  mimeType     String              @map("mime_type") @db.VarChar(255)
  sizeBytes    Int                 @map("size_bytes") // 单文件 ≤ 2GB
  checksum     String?             @map("checksum") @db.VarChar(128) // sha256，用于去重与完整性校验
  scanStatus   FileScanStatus      @default(SKIPPED) @map("scan_status") // 未配置扫描时不做安全承诺
  scannedAt    DateTime?           @map("scanned_at") @db.Timestamptz(3)
  isPublic     Boolean             @default(false) @map("is_public")
  uploadedById String?             @map("uploaded_by_id")
  metadata     Json?               @map("metadata") @db.JsonB // 图片宽高、PDF 页数等

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3) // 逻辑删除，物理清理由独立任务处理
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarOf    User?        @relation("UserAvatar")
  attachments Attachment[]

  @@index([uploadedById])
  @@index([checksum])
  @@index([scanStatus])
  @@map("file_objects")
}

model Attachment {
  id           String     @id @default(uuid()) @map("id")
  fileId       String     @map("file_id")
  entityType   EntityType @map("entity_type")
  entityId     String     @map("entity_id")
  label        String?    @map("label") @db.VarChar(255)
  sortOrder    Int        @default(0) @map("sort_order")
  uploadedById String?    @map("uploaded_by_id")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  file       FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, deletedAt])
  @@index([fileId])
  @@map("attachments")
}

// ============================ 审计与系统日志 ================================

// 只追加：数据库层用触发器禁止 UPDATE/DELETE（见 baseline 迁移）
model AuditLog {
  id            String      @id @default(uuid()) @map("id")
  actorId       String?     @map("actor_id")
  actorName     String?     @map("actor_name") @db.VarChar(128) // 快照：用户被删后仍可追溯
  actorRole     String?     @map("actor_role") @db.VarChar(64) // 快照
  // M-1 §4：动词/事件优先的 19 项取值（create / login.failed / status.change ...）
  // 禁止恢复 Prisma enum AuditAction；展示标签走 EnumMeta(enumName='AuditAction')。
  action        String      @map("action") @db.VarChar(64)
  entityType    EntityType? @map("entity_type")
  entityId      String?     @map("entity_id")
  entityLabel   String?     @map("entity_label") @db.VarChar(255) // 快照，如项目名
  before        Json?       @map("before") @db.JsonB
  after         Json?       @map("after") @db.JsonB
  changedFields String[]    @map("changed_fields")
  // elevated / override / breakGlass / permissionCode 等审计上下文
  metadata      Json?       @map("metadata") @db.JsonB
  ip            String?     @map("ip") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(512)
  requestId     String?     @map("request_id") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  // GIN 索引 audit_logs_metadata_gin_idx 由 baseline 迁移「手工补充部分」创建
  // （Prisma schema 无法声明 jsonb GIN，见 migrations/*/migration.sql 尾部）
  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid()) @map("id")
  level     LogLevel @default(INFO) @map("level")
  category  String   @map("category") @db.VarChar(64) // auth / project / report ...
  action    String   @map("action") @db.VarChar(64)
  message   String   @map("message")
  context   Json?    @map("context") @db.JsonB
  userId    String?  @map("user_id")
  ip        String?  @map("ip") @db.VarChar(45)
  requestId String?  @map("request_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level, createdAt])
  @@index([userId, createdAt])
  @@index([category, action])
  @@map("system_logs")
}

// ============================== 系统支撑表 ==================================

// 枚举展示字典：DB 存英文 enum 值，中文名/颜色/排序由本表提供，前端下拉与字典接口读此表
model EnumMeta {
  id        String  @id @default(uuid()) @map("id")
  enumName  String  @map("enum_name") @db.VarChar(64) // ProjectStatus / TaskPriority ...
  code      String  @map("code") @db.VarChar(64) // IN_PROGRESS
  label     String  @map("label") @db.VarChar(128) // 进行中
  color     String? @map("color") @db.VarChar(32)
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")
  isEnabled Boolean @default(true) @map("is_enabled")

  @@unique([enumName, code])
  @@index([enumName, sortOrder])
  @@map("enum_meta")
}

// 业务编号发号器：避免应用层 count()+1 竞态
model CodeSequence {
  id        String   @id @default(uuid()) @map("id")
  scope     String   @map("scope") @db.VarChar(64) // PROJECT / PRIMER / SAMPLE ...
  periodKey String   @default("") @map("period_key") @db.VarChar(16) // "" 或 "2026"
  prefix    String   @map("prefix") @db.VarChar(32) // PRJ-2026-
  padding   Int      @default(3) @map("padding")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, periodKey])
  @@map("code_sequences")
}

model SystemSetting {
  key         String   @id @map("key") @db.VarChar(128)
  value       Json     @map("value") @db.JsonB
  description String?  @map("description")
  isPublic    Boolean  @default(false) @map("is_public") // 是否可下发给未登录前端
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id")

  @@map("system_settings")
}
