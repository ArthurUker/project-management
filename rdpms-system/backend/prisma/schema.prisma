model DocCategory {
  id          String         @id @default(uuid()) @map("id")
  code        String         @unique @map("code") @db.VarChar(64)
  name        String         @map("name") @db.VarChar(128)
  description String?        @map("description")
  icon        String?        @map("icon") @db.VarChar(64)
  parentId    String?        @map("parent_id")
  sortOrder   Int            @default(0) @map("sort_order")
  status      DocumentStatus @default(ACTIVE) @map("status")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    DocCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DocCategory[] @relation("CategoryTree")
  documents DocDocument[]

  @@index([parentId, sortOrder])
  @@map("doc_categories")
