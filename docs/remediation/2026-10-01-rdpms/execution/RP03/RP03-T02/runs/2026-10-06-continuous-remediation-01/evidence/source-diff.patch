+const db=new PrismaClient();const prefix=crypto.randomUUID();const password='SequoiaHarbor71!Acorn';const changed='WillowRiver39!Maple';let app,admin,adminTokens;let n=0;const traces=[];
+async function makeUser(role='MEMBER'){const id=`rp03-${prefix}-${++n}`;const u=await db.user.create({data:{id,username:id,displayName:'RP03 synthetic',passwordHash:await bcrypt.hash(password,4),systemRole:role,status:'ACTIVE'}});await setRealSyncPermissions(db,id,['users.view','projects.view']);return u;}
+function request(a,token,method,url,body){return a.request(url,{method,headers:{authorization:`Bearer ${token}`,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});}
