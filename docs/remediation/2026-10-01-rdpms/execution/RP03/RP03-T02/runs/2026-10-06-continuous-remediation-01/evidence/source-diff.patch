+test('RP03 reset between old-password validation and conditional login issuance cannot mint successor/versioned JWT',async()=>{const u=await makeUser();const gate=loginGate(u);let pending,timer;try{pending=gate.app.request('/api/auth/login',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({username:u.username,password})});await Promise.race([gate.reached,new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error('RP03_LOGIN_GATE_MISSING')),10000);})]);assert.equal(gate.hit(),true);assert.equal((await request(app,adminTokens.accessToken,'PUT',`/api/users/${u.id}/reset-password`,{newPassword:changed})).status,200);}finally{clearTimeout(timer);gate.release();}const rejected=await pending;assert.equal(rejected.status,401);assert.equal((await rejected.json()).code,'LOGIN_STATE_CHANGED');assert.equal(await db.refreshToken.count({where:{userId:u.id}}),0);assert.equal(await db.auditLog.count({where:{actorId:u.id,action:'login'}}),0);assert.equal((await db.user.findUnique({where:{id:u.id}})).lastLoginAt,null);assert.equal(jwt.decode((await login(u,changed)).accessToken).securityVersion,1);});
