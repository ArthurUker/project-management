+function loginGate(u){let enter,release;let hit=false;const reached=new Promise(r=>enter=r);const released=new Promise(r=>release=r);const client=new Proxy(db,{get(target,key){if(key==='user')return new Proxy(target.user,{get(model,m){if(m==='updateMany')return async args=>{if(!hit&&args.where.id===u.id&&args.data.lastLoginAt){hit=true;enter();await released;}return model.updateMany(args);};const v=model[m];return typeof v==='function'?v.bind(model):v;}});const v=target[key];return typeof v==='function'?v.bind(target):v;}});return{app:createApp({db:client}),reached,release,hit:()=>hit};}
