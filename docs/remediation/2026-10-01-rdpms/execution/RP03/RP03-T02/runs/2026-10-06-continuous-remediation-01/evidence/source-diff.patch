+test('RP03 versioned login/refresh use actual DB version; legacy missing version fails closed',async()=>{const u=await makeUser();const tokens=await login(u);assert.equal(jwt.decode(tokens.accessToken).securityVersion,0);assert.equal((await request(app,tokens.accessToken,'GET','/api/auth/me')).status,200);const legacy=jwt.sign({userId:u.id,systemRole:u.systemRole},process.env.JWT_SECRET,{expiresIn:'15m'});const rejected=await request(app,legacy,'GET','/api/auth/me');assert.equal(rejected.status,401);assert.equal((await rejected.json()).code,'SESSION_VERSION_REQUIRED');const r=await refresh(tokens.refreshToken);assert.equal(r.status,200);const next=await r.json();assert.equal(jwt.decode(next.accessToken).securityVersion,0);assert.equal((await request(app,next.accessToken,'GET','/api/auth/me')).status,200);});
+
+test('RP03 self password change atomically bumps version and revokes access/refresh; new password login works',async()=>{const u=await makeUser();const tokens=await login(u);const r=await request(app,tokens.accessToken,'PUT','/api/auth/password',{oldPassword:password,newPassword:changed});assert.equal(r.status,200);await revoked(u,tokens,1);const next=await login(u,changed);assert.equal(jwt.decode(next.accessToken).securityVersion,1);assert.equal((await request(app,next.accessToken,'GET','/api/users')).status,200);assert.equal((await db.user.findUnique({where:{id:u.id}})).mustChangePassword,false);});
+
+test('RP03 admin reset and force-change each revoke previous version without bypassing forced endpoint boundary',async()=>{const u=await makeUser();const tokens=await login(u);const reset=await request(app,adminTokens.accessToken,'PUT',`/api/users/${u.id}/reset-password`,{newPassword:changed});assert.equal(reset.status,200);await revoked(u,tokens,1);const fresh=await login(u,changed);assert.equal(jwt.decode(fresh.accessToken).securityVersion,1);const denied=await request(app,fresh.accessToken,'GET','/api/users');assert.equal(denied.status,403);assert.equal((await denied.json()).code,'PASSWORD_CHANGE_REQUIRED');assert.equal((await request(app,fresh.accessToken,'PUT','/api/auth/password/force',{newPassword:password})).status,200);await revoked(u,fresh,2);assert.equal((await request(app,(await login(u)).accessToken,'GET','/api/users')).status,200);});
