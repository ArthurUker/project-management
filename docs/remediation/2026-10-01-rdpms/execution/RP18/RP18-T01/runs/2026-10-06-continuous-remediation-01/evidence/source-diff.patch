-# 判断 enum 是否包含某成员（在 enum 块内精确匹配，避免跨 enum 误判）
-enum_has() {
-  local enum="$1" member="$2"
-  awk -v e="$enum" -v m="$member" '
-    $1 == "enum" && $2 == e { inside = 1; next }
-    inside && $1 == "}"      { inside = 0 }
-    inside && $1 == m        { found = 1 }
-    END { exit(found ? 0 : 1) }
-  ' "$SCHEMA"
-}
