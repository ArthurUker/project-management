+const url=new URL(process.env.DATABASE_URL);assert.equal(url.hostname,'127.0.0.1');assert.equal(url.pathname.slice(1),process.env.RDPMS_EXEC_OWNED_DB);const db=new PrismaClient(),app=createApp({db}),id=()=>crypto.randomUUID(),trace=[];let actor,token,project,device=id();
