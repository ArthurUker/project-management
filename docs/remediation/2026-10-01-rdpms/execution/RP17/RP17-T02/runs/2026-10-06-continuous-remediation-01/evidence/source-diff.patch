+ os.umask(0o077)
+ db=os.environ.get('DB_NAME','rdpms');run=os.environ.get('RUN_ID') or datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+uuid.uuid4().hex[:12]
