 TS="$(date +%Y%m%d-%H%M%S)"
+STAGING=""
+cleanup_staging() {
+  if [ -n "$STAGING" ] && [ -d "$STAGING" ]; then
+    sudo rm -rf "$STAGING"
+  fi
+}
+trap cleanup_staging EXIT
 
