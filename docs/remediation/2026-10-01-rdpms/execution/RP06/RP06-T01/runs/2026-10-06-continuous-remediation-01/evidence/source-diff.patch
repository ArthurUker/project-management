+test('current scope recheck after native JWT before project lock fences membership removal',async()=>{const p=await fixture();const before=await state(p);let hit,release;const reached=new Promise(r=>hit=r),gate=new Promise(r=>release=r);const server=createApp({db:new Proxy(db,{get(t,k){if(k==='$transaction')return(fn,opts)=>t.$transaction(tx=>fn(new Proxy(tx,{get(t,k){if(k==='$queryRaw')return async(...args)=>{if(String(args[0]).includes('FROM projects')){hit();await gate;}return t.$queryRaw(...args);};return typeof t[k]==='function'?t[k].bind(t):t[k];}})),opts);return typeof t[k]==='function'?t[k].bind(t):t[k];}})});const pending=request('member','/'+p.id,'PUT',{name:'must not write'},server);let timer;try{await Promise.race([reached,new Promise((_,reject)=>timer=setTimeout(()=>reject(Error('project barrier not reached')),5000))]);await db.projectMember.update({where:{projectId_userId:{projectId:p.id,userId:actors.member.id}},data:{leftAt:new Date()}});}finally{clearTimeout(timer);release();}assert.equal((await pending).r.status,404);const after=await state(p);assert.deepEqual(after.project,before.project);assert.deepEqual(after.profile,before.profile);assert.deepEqual(after.audits,before.audits);});
