--- before/rdpms-system/backend/tests/integration/rp06-registration-manager-adapter.integration.test.mjs
+++ after/rdpms-system/backend/tests/integration/rp06-registration-manager-adapter.integration.test.mjs
@@ -0,0 +1,14 @@
+import { test, before, after } from 'node:test'; import assert from 'node:assert/strict'; import crypto from 'node:crypto'; import fs from 'node:fs'; import path from 'node:path'; import bcrypt from 'bcryptjs';
+import { PrismaClient } from '@prisma/client'; import { createApp } from '../../dist/bootstrap/createApp.js'; import { setRealSyncPermissions } from '../helpers/syncV1Fixture.mjs';
+const u=new URL(process.env.DATABASE_URL);assert.equal(u.hostname,'127.0.0.1');assert.equal(u.pathname.slice(1),process.env.RDPMS_EXEC_OWNED_DB);
+const db=new PrismaClient(),app=createApp({db}),uuid=()=>crypto.randomUUID(),trace=[];let actor,old,target,outside,token;
+const grants=['registrations.view','registrations.update','projects.view','projects.manage_members'];
+async function user(label){return db.user.create({data:{username:'rp06adapter-'+label+'-'+uuid(),displayName:'Synthetic '+label,status:'ACTIVE',systemRole:'MEMBER',passwordHash:await bcrypt.hash('Owned adapter fixture 2026!',4)}})}
+async function fixture(){return db.project.create({data:{code:'ADAPTER-'+uuid(),name:'Synthetic registration adapter',subtype:'registration',type:'CUSTOMIZATION',managerId:old.id,createdById:actor.id,registrationProfile:{create:{notes:'original profile'}},members:{create:[{userId:actor.id,role:'OWNER'},{userId:old.id,role:'MANAGER'},{userId:target.id,role:'VIEWER'}]}}})}
+async function call(p,body,server=app){const r=await server.request('/api/registrations/'+p.id,{method:'PUT',headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body)});const v=await r.json();trace.push({projectId:p.id,body,status:r.status,response:v});return {r,v};}
+async function state(p){return {project:await db.project.findUnique({where:{id:p.id}}),profile:await db.registrationProfile.findUnique({where:{projectId:p.id}}),members:await db.projectMember.findMany({where:{projectId:p.id},orderBy:{userId:'asc'}}),audits:await db.auditLog.findMany({where:{entityId:p.id},orderBy:{createdAt:'asc'}})}}
+before(async()=>{actor=await user('owner');old=await user('old');target=await user('target');outside=await user('outside');await setRealSyncPermissions(db,actor.id,grants);const r=await app.request('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:actor.username,password:'Owned adapter fixture 2026!'})});assert.equal(r.status,200);const body=await r.json();assert.equal(body.user.id,actor.id);token=body.accessToken;});
+after(async()=>{try{fs.writeFileSync(path.join(process.env.RDPMS_EXEC_EVIDENCE_DIR,'persistent-state.json'),JSON.stringify({trace,projects:await db.project.findMany(),profiles:await db.registrationProfile.findMany(),members:await db.projectMember.findMany(),audits:await db.auditLog.findMany()},null,2));}finally{await db.$disconnect()}});
+test('authorized native registration transfer atomically updates profile and shared membership then returns same actual scoped detail',async()=>{const p=await fixture();const result=await call(p,{managerId:target.id,baseUpdatedAt:p.updatedAt.toISOString(),name:'Updated adapter',notes:'Updated profile'});assert.equal(result.r.status,200);const s=await state(p);assert.equal(s.project.managerId,target.id);assert.equal(s.profile.notes,'Updated profile');assert.equal(s.members.find(m=>m.userId===actor.id).role,'OWNER');assert.equal(s.members.find(m=>m.userId===target.id).role,'MANAGER');assert.equal(s.members.find(m=>m.userId===old.id).role,'MEMBER');assert.ok(s.members.every(m=>m.leftAt===null));assert.equal(s.audits.filter(a=>a.metadata?.command==='TRANSFER_MANAGER_V1').length,1);const detail=await app.request('/api/registrations/'+p.id,{headers:{Authorization:'Bearer '+token}});assert.equal(detail.status,200);assert.equal((await detail.json()).managerId,target.id);});
+test('registration update alone cannot move manager; exact baseline and active sameproject target remain mandatory',async()=>{const p=await fixture();await setRealSyncPermissions(db,actor.id,grants.filter(x=>x!=='projects.manage_members'));let before=await state(p);assert.equal((await call(p,{managerId:target.id,baseUpdatedAt:p.updatedAt.toISOString(),notes:'denied'})).r.status,403);assert.deepEqual(await state(p),before);await setRealSyncPermissions(db,actor.id,grants);for(const body of [{managerId:target.id},{managerId:target.id,baseUpdatedAt:'2000-01-01',notes:'stale'},{managerId:outside.id,baseUpdatedAt:p.updatedAt.toISOString()},{managerId:{id:target.id}}]){before=await state(p);assert.ok([400,409].includes((await call(p,body)).r.status));assert.deepEqual(await state(p),before);}});
+test('profile and final audit failure roll back shared transfer and all relation effects; no partially committed registration adapter',async()=>{for(const model of ['registrationProfile','auditLog']){const p=await fixture();const before=await state(p);const proxy=new Proxy(db,{get(t,k){if(k==='$transaction')return(fn,opts)=>t.$transaction(tx=>fn(new Proxy(tx,{get(t,k){if(k===model)return new Proxy(t[k],{get(m,k){if(k===(model==='auditLog'?'create':'update'))return async()=>{throw Error('OWNED_ADAPTER_'+model)};return typeof m[k]==='function'?m[k].bind(m):m[k];}});return typeof t[k]==='function'?t[k].bind(t):t[k];}})),opts);return typeof t[k]==='function'?t[k].bind(t):t[k];}});assert.equal((await call(p,{managerId:target.id,baseUpdatedAt:p.updatedAt.toISOString(),notes:'must roll back'},createApp({db:proxy}))).r.status,500);assert.deepEqual(await state(p),before);}});
