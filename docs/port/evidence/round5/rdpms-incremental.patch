+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createApp } from '../../dist/bootstrap/createApp.js';
+import { createStubDb, createStubActor, jsonRequest, createGate } from '../helpers/stubDeps.mjs';
