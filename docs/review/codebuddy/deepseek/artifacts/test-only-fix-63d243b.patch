--- /dev/null
+++ b/rdpms-system/frontend/tests/unit/helpers/offlineOwnerFixture.ts
@@ -0,0 +1,118 @@
+/**
+ * 离线 owner/session 测试夹具（TEST_ONLY，不含业务行为改动）
+ *
+ * 背景：`src/offline/idb.ts` 在账号隔离修复后只公开
+ *   idb.activateOwner(owner) / idb.deactivateOwner(owner) / idb.forOwner(owner)
+ * 且每次存储操作都会校验 userId、loginGeneration、当前 tokenStore 会话，
+ * 以及 IndexedDB 中登记的 activeSession。旧用例调用的全局无主体接口
+ * （idb.kvSet / idb.clearAll / idb.outboxClear ...）已不存在，也不是要恢复的目标。
+ *
+ * 本夹具用**真实 tokenStore 接口**建立合成登录，因此 owner 与会话的绑定关系
+ * 与生产路径一致：
+ *   beginLogin() → finishLogin(ticket, userId, accessToken, refreshToken) → activateOwner(owner)
+ *
+ * 关键约束（夹具不能绕过，否则测试就失去意义）：
+ *   1. 进程内同一时刻只有一个「当前会话」。loginOwner(B) 会让 A 的 owner 失效，
+ *      A 的后续读写必须重新 loginOwner(A)（生成新 loginGeneration）。
+ *   2. 数据按 userId 分片（ownerKey = [userId, key]），因此重新登录后 A 的数据仍可读回；
+ *      但失效的旧 owner 对象不能继续使用。
+ *   3. 访问非当前主体的 owner 会被拒绝（OFFLINE_SESSION_CHANGED /
+ *      OFFLINE_OWNER_FENCE_CHANGED / OFFLINE_OWNER_MISMATCH），测试应断言「被拒绝」，
+ *      而不是改成成功。
+ */
+import { tokenStore, type SessionSnapshot } from '../../../src/auth/tokenStore';
+import { idb, type OfflineOwner, type OwnedIdb } from '../../../src/offline/idb';
+
+/** 夹具使用的固定 dataset epoch（tokenStore.datasetEpoch() 要求 36 位 UUID 形态）。 */
+export const FIXTURE_DATASET_EPOCH = '11111111-2222-3333-4444-555555555555';
+
+function b64url(value: unknown): string {
+  const bytes = new TextEncoder().encode(JSON.stringify(value));
+  let binary = '';
+  bytes.forEach((byte) => {
+    binary += String.fromCharCode(byte);
+  });
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/**
+ * 合成 access token。tokenStore.accessActor() 只解 JWT payload 的 userId，
+ * finishLogin() 会校验 accessActor(accessToken) === actorId，因此 payload 必须带 userId。
+ */
+export function synthAccessToken(userId: string, datasetEpoch: string = FIXTURE_DATASET_EPOCH): string {
+  const header = b64url({ alg: 'HS256', typ: 'JWT' });
+  const payload = b64url({ userId, systemRole: 'MEMBER', securityVersion: 0, datasetEpoch });
+  return `${header}.${payload}.fixture-signature`;
+}
+
+let userCounter = 0;
+
+/**
+ * 生成测试内唯一的主体标识。
+ *
+ * 必要性：fake-indexeddb 在同一测试文件（同一进程）内共享底层存储，
+ * 若多个用例复用 `user-a` / `user-b`，前一个用例写入的分片会残留并污染后续断言。
+ * 用唯一标识可以保证每个用例只读写**自己创建的分区**，也就不需要跨用例清理。
+ */
+export function uniqueUser(prefix: string): string {
+  userCounter += 1;
+  return `${prefix}-${userCounter}`;
+}
+
+export interface OwnerFixture {
+  userId: string;
+  owner: OfflineOwner;
+  session: SessionSnapshot;
+  owned: OwnedIdb;
+}
+
+/**
+ * 以真实 tokenStore 建立合成登录并激活 IDB owner。
+ * 调用它会替换当前会话：此前主体的 owner 立即失效。
+ */
+export async function loginOwner(userId: string): Promise<OwnerFixture> {
+  const ticket = await tokenStore.beginLogin();
+  const session = await tokenStore.finishLogin(ticket, userId, synthAccessToken(userId), `fixture-refresh.${userId}`);
+  if (!session) throw new Error(`OFFLINE_FIXTURE_LOGIN_FAILED:${userId}`);
+  const owner: OfflineOwner = { userId, loginGeneration: session.loginGeneration };
+  await idb.activateOwner(owner);
+  return { userId, owner, session, owned: idb.forOwner(owner) };
+}
+
+/** 重新登录同一 userId（切换回该主体）。数据仍在，但 loginGeneration 是新的。 */
+export async function reloginOwner(userId: string): Promise<OwnerFixture> {
+  return loginOwner(userId);
+}
+
+/**
+ * 登出当前主体：先让会话失效，再让 IDB 的 activeSession 登记失效。
+ * 只影响该主体，不触碰其他主体的分片数据。
+ */
+export async function logoutOwner(fixture: OwnerFixture): Promise<void> {
+  await tokenStore.expireIfOwned(fixture.session);
+  await idb.deactivateOwner(fixture.owner);
+}
+
+/** 断言「非当前主体的访问被拒绝」——不得改成成功，也不得借用他人会话。 */
+export async function assertRejected(promise: Promise<unknown>, reason: string): Promise<string> {
+  try {
+    await promise;
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+  throw new Error(`EXPECTED_REJECTION_BUT_RESOLVED:${reason}`);
+}
+
+/** 清理夹具在当前测试中创建的分片，避免污染同文件内的后续用例。 */
+export async function disposeOwner(fixture: OwnerFixture): Promise<void> {
+  try {
+    await tokenStore.expireIfOwned(fixture.session);
+  } catch {
+    /* 会话可能已被后续登录替换，忽略 */
+  }
+  try {
+    await idb.deactivateOwner(fixture.owner);
+  } catch {
+    /* 同上 */
+  }
+}
